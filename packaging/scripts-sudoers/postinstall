#!/bin/bash
# Installs the sudo rule that allows exactly two pmset commands without a password.
# Nothing here may fail the installation of the app itself — always exit 0.
set -u

SUDOERS="/etc/sudoers.d/sleepswitch"
PMSET="/usr/bin/pmset"

TARGET_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
	TARGET_USER="${USER:-}"
fi
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
	echo "SleepSwitch: could not tell who is installing — sudo rule skipped." >&2
	exit 0
fi

# The short name goes straight into sudoers, so only safe characters get through.
case "$TARGET_USER" in
	-* | *[!A-Za-z0-9._-]*)
		echo "SleepSwitch: unsupported name “$TARGET_USER” — sudo rule skipped." >&2
		exit 0
		;;
esac

# The rule only makes sense for an administrator: a standard user cannot change power
# settings anyway, and handing them new rights is not ours to do.
if ! /usr/bin/dsmemberutil checkmembership -U "$TARGET_USER" -G admin 2>/dev/null |
	/usr/bin/grep -q "is a member"; then
	echo "SleepSwitch: “$TARGET_USER” is not an administrator — sudo rule skipped." >&2
	exit 0
fi

WORK="$(/usr/bin/mktemp -d)" || exit 0
DRAFT="$WORK/sleepswitch"

/bin/cat > "$DRAFT" <<EOF
# Installed by SleepSwitch.
# Allows toggling the sleep ban without a password — and nothing else.
# Remove with: sudo rm $SUDOERS
$TARGET_USER ALL=(root) NOPASSWD: $PMSET -a disablesleep 0
$TARGET_USER ALL=(root) NOPASSWD: $PMSET -a disablesleep 1
EOF

if /usr/sbin/visudo -cf "$DRAFT" >/dev/null 2>&1; then
	/usr/bin/install -m 0440 -o root -g wheel "$DRAFT" "$SUDOERS"
	echo "SleepSwitch: sudo rule installed for $TARGET_USER."
else
	echo "SleepSwitch: the rule failed the visudo check — skipped." >&2
fi

/bin/rm -rf "$WORK"
exit 0
